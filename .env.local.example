# Convex (backend & database)
CONVEX_DEPLOYMENT=your-convex-deployment-slug
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Google Gemini — set this in the Convex dashboard's environment variables instead,
# not here. It's read server-side inside Convex actions (convex/ai.ts) and is never
# used by the Next.js app directly.
# GEMINI_API_KEY=AIza...
